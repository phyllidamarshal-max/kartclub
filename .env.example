# Optional frontend build setting. Leave empty when Node serves both the page and races.
# For Netlify, use the HTTPS origin of your running race service and rebuild.
VITE_GAME_SERVER_URL=

# Server runtime settings (set in your host environment; npm start does not load this file).
PORT=2567
PONS_DATA_DIR=./data
# Comma-separated browser origins; no trailing slash or path. Empty allows any origin.
ALLOWED_ORIGINS=
